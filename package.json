{
  "name": "keybound",
  "version": "0.1.0",
  "description": "Device-key session proof for Node.js. Make copied cookies harder to replay.",
  "type": "module",
  "license": "MIT",
  "author": "chrisch88dev",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chrisch88dev/keybound.git"
  },
  "bugs": {
    "url": "https://github.com/chrisch88dev/keybound/issues"
  },
  "homepage": "https://github.com/chrisch88dev/keybound#readme",
  "keywords": [
    "session-security",
    "cookie-security",
    "session-replay",
    "device-binding",
    "proof-of-possession",
    "nodejs",
    "typescript",
    "security",
    "express",
    "fastify",
    "nextjs"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "demo": "npm run build && node examples/node-proof.mjs",
    "demo:login": "npm run build && node examples/login-site/server.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
